# VeriCommit Environment Variables Template

# GitHub Evidence Retrieval (Prompt 06)
# Optional for unauthenticated public repo queries (60 req/hr limit).
# Required for private repos or higher rate limits (5,000 req/hr).
# GitHub personal access token with 'repo' scope (for private repos) or public read.
GITHUB_TOKEN=

# Gemini API Integration (Future - Prompt 07)
GEMINI_API_KEY=

# Firebase Client Configuration is read from firebase-applet-config.json
