# VeriCommit Environment Variables Template

# GitHub Evidence Retrieval (Prompt 06)
# Optional for public repository retrieval (subject to GitHub IP rate limit of 60 req/hr).
# Recommended to configure a personal access token for higher limits (5,000 req/hr) and authenticated access.
# Scope: 'public_repo' read access.
# NOTE: Read exclusively on the server side. Never expose with VITE_ prefix or in client code.
GITHUB_TOKEN=

# Gemini API Integration (Pending - Prompt 07)
# Used server-side for structured evaluation generation against agreed criteria.
GEMINI_API_KEY=

# Firebase Client Configuration is loaded from firebase-applet-config.json
