rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Funding Agreements: Restricted to participants (Grantor and Grantee)
    match /funding_agreements/{agreementId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.grantorId ||
        request.auth.uid == resource.data.granteeId ||
        (resource.data.grantorEmail != null && request.auth.token.email != null && request.auth.token.email.lower() == resource.data.grantorEmail.lower()) ||
        (resource.data.granteeEmail != null && request.auth.token.email != null && request.auth.token.email.lower() == resource.data.granteeEmail.lower())
      );
      
      allow create: if isSignedIn() && isValidId(agreementId)
        && incoming().keys().hasAll(['id', 'title', 'grantorId', 'granteeId', 'status', 'createdAt'])
        && incoming().id is string && incoming().title is string && incoming().title.size() <= 200
        && incoming().status in ['active', 'completed', 'terminated'];
        
      allow update: if isSignedIn() && isValidId(agreementId)
        && incoming().id == existing().id
        && (
          request.auth.uid == existing().grantorId ||
          request.auth.uid == existing().granteeId ||
          (existing().grantorEmail != null && request.auth.token.email != null && request.auth.token.email.lower() == existing().grantorEmail.lower()) ||
          (existing().granteeEmail != null && request.auth.token.email != null && request.auth.token.email.lower() == existing().granteeEmail.lower())
        );
        
      allow delete: if false;

      // Sub-collection Milestones: Belonging strictly to the parent Funding Agreement
      match /milestones/{milestoneId} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/funding_agreements/$(agreementId)).data.grantorId == request.auth.uid ||
          get(/databases/$(database)/documents/funding_agreements/$(agreementId)).data.granteeId == request.auth.uid ||
          (get(/databases/$(database)/documents/funding_agreements/$(agreementId)).data.grantorEmail != null && request.auth.token.email != null && request.auth.token.email.lower() == get(/databases/$(database)/documents/funding_agreements/$(agreementId)).data.grantorEmail.lower()) ||
          (get(/databases/$(database)/documents/funding_agreements/$(agreementId)).data.granteeEmail != null && request.auth.token.email != null && request.auth.token.email.lower() == get(/databases/$(database)/documents/funding_agreements/$(agreementId)).data.granteeEmail.lower())
        );

        allow create: if isSignedIn() && isValidId(milestoneId)
          && incoming().keys().hasAll(['id', 'fundingAgreementId', 'title', 'evidenceSource', 'createdAt'])
          && incoming().fundingAgreementId == agreementId
          && incoming().title is string && incoming().title.size() <= 200
          && incoming().evidenceSource in ['github', 'sample']
          && (
            get(/databases/$(database)/documents/funding_agreements/$(agreementId)).data.grantorId == request.auth.uid ||
            get(/databases/$(database)/documents/funding_agreements/$(agreementId)).data.granteeId == request.auth.uid ||
            (get(/databases/$(database)/documents/funding_agreements/$(agreementId)).data.grantorEmail != null && request.auth.token.email != null && request.auth.token.email.lower() == get(/databases/$(database)/documents/funding_agreements/$(agreementId)).data.grantorEmail.lower()) ||
            (get(/databases/$(database)/documents/funding_agreements/$(agreementId)).data.granteeEmail != null && request.auth.token.email != null && request.auth.token.email.lower() == get(/databases/$(database)/documents/funding_agreements/$(agreementId)).data.granteeEmail.lower())
          );

        allow update: if isSignedIn() && isValidId(milestoneId)
          && incoming().id == existing().id
          && incoming().fundingAgreementId == existing().fundingAgreementId
          && (
            get(/databases/$(database)/documents/funding_agreements/$(agreementId)).data.grantorId == request.auth.uid ||
            get(/databases/$(database)/documents/funding_agreements/$(agreementId)).data.granteeId == request.auth.uid ||
            (get(/databases/$(database)/documents/funding_agreements/$(agreementId)).data.grantorEmail != null && request.auth.token.email != null && request.auth.token.email.lower() == get(/databases/$(database)/documents/funding_agreements/$(agreementId)).data.grantorEmail.lower()) ||
            (get(/databases/$(database)/documents/funding_agreements/$(agreementId)).data.granteeEmail != null && request.auth.token.email != null && request.auth.token.email.lower() == get(/databases/$(database)/documents/funding_agreements/$(agreementId)).data.granteeEmail.lower())
          );

        allow delete: if false;
      }
    }

    // Evaluations: Read-only snapshot records
    match /evaluations/{evaluationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(evaluationId)
        && incoming().keys().hasAll(['evaluation_id', 'project_name', 'milestone_title', 'overall_summary', 'human_review_required', 'evaluated_at'])
        && incoming().human_review_required == true;
      allow update, delete: if false; // Evaluations are snapshot assessments
    }

    // Human Decisions: Must be Grantor role, required reasoning >= 10 chars, immutable
    match /human_decisions/{decisionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(decisionId)
        && incoming().keys().hasAll(['decision_id', 'agreement_id', 'milestone_id', 'reviewer_name', 'reviewer_role', 'status', 'reasoning', 'recorded_at'])
        && incoming().reviewer_role == 'Grantor'
        && incoming().status in ['approved', 'rejected', 'changes_requested']
        && incoming().reasoning is string && incoming().reasoning.size() >= 10 && incoming().reasoning.size() <= 2000
        && (
          incoming().reviewer_uid == request.auth.uid ||
          (incoming().reviewer_email != null && request.auth.token.email != null && incoming().reviewer_email.lower() == request.auth.token.email.lower())
        )
        && (
          get(/databases/$(database)/documents/funding_agreements/$(incoming().agreement_id)).data.grantorId == request.auth.uid ||
          (get(/databases/$(database)/documents/funding_agreements/$(incoming().agreement_id)).data.grantorEmail != null && request.auth.token.email != null && request.auth.token.email.lower() == get(/databases/$(database)/documents/funding_agreements/$(incoming().agreement_id)).data.grantorEmail.lower())
        );
      allow update, delete: if false; // Decisions cannot be silently rewritten
    }

    // Audit Logs: Append-Only Immutable Records
    match /audit_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(logId)
        && incoming().keys().hasAll(['id', 'timestamp', 'actor', 'action', 'entityType', 'entityId', 'details'])
        && incoming().details is string && incoming().details.size() <= 4000;
      allow update, delete: if false; // Non-repudiable audit logs
    }
  }
}
